"AppBuild"
{
    "AppID"         "REPLACE_WITH_REAL_APP_ID"
    "Desc"          "Land of Magic Godot Build"
    "BuildOutput"   "../../steamcmd_output/"
    "ContentRoot"   "..\export\windows\"
    "SetLive"       ""
    "Preview"       "0"

    "Depots"
    {
        "REPLACE_WITH_DEPOT_ID"
        {
            "FileMapping"
            {
                "LocalPath"     "*"
                "DepotPath"     "."
                "recursive"     "1"
            }
            "FileExclusion"     "*.pdb"
        }
    }
}
